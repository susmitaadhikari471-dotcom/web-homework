<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Business Card</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="card">
    <h1>Adhikari Susmita</h1>
    <p>Student | Web Development & Programming</p>
    
    <button class="btn">Contact Me</button>
    <button class="btn">Portfolio</button>
  </div>

</body>
</html>

/* 1. Global Box-Sizing Setup (Border-box) */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f4f4f4;
}

/* 2. Card Styling (Border & Padding - Mission 1 Requirements) */
.card {
  background: white;
  border: 2px solid #333; /* Visual Border */
  padding: 20px;          /* Internal Padding */
  border-radius: 8px;
  text-align: center;
  max-width: 350px;
}

/* 3. Text Spacing (Margin Bottom) */
h1 {
  margin-bottom: 20px;
  color: #222;
}

p {
  margin-bottom: 20px;
  color: #666;
}

/* 4. Button Spacing (Margin Right) */
.btn {
  padding: 10px 15px;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  margin-right: 15px; /* Space between buttons */
}

.btn:last-child {
  margin-right: 0;
}
