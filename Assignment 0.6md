<<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adhikari Susmita - Business Card</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="card">
    <h1>Adhikari Susmita</h1>
    <p class="title">Computer Engineering Student</p>
    <p class="info">Seoul Theological University | Seoul, South Korea</p>
    
    <div class="buttons">
      <button class="btn">Contact Me</button>
      <button class="btn">GitHub</button>
    </div>
  </div>

</body>
</html>

/
  color: #666;
  font-size: 1* 1. Global Box-Sizing (Assignment Requirement) */
* {
  box-sizing: border-box;
}

/* Body Center Alignment */
body {
  font-family: Arial, sans-serif;
  background-color: #f0f2f5;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

/* 2. Card Styling (Border, Padding, ra Margin include gareko) */
.card {
  width: 350px;
  background-color: #ffffff;
  border: 2px solid #2c3e50;    /* Border requirement */
  padding: 25px;                /* Padding requirement */
  margin: 20px auto;            /* Margin requirement */
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

/* 3. Text ra Elements ko Spacing */
.card h1 {c;
}

.card .title {
  font-weight: bold;
  color: #ffe600;
  margin-bottom: 5px
  margin-top: 0;
  margin-bottom: 8px;
  color: #45502;
}

.card .info {4px;
  margin-bottom: 20px;
}

/* Button Styling & Margin */
.btn {
  padding: 10px 18px;
  margin-right: 10px;           /* Buttons bich ko Margin */
  border: none;
  background-color: #ff00d4;
  color: white;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
}

.btn:last-child {
  margin-right: 0;
}

.btn:hover {
  background-color: #5fb300;
}
